{
  "name": "tu-tien-client",
  "description": "2D H5 cultivation game client built with Phaser, Vue, TypeScript, and Vite.",
  "version": "1.3.0",
  "license": "MIT",
  "keywords": [
    "phaser",
    "phaser3",
    "typescript",
    "vue",
    "vite"
  ],
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "phaser": "^3.88.2",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "terser": "^5.31.0",
    "@vitejs/plugin-vue": "^5.2.2",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vue-tsc": "^2.2.8"
  }
}
